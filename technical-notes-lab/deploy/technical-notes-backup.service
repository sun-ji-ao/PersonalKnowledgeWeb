[Unit]
Description=Back up Technical Notes SQLite, archives and media
After=technical-notes.service

[Service]
Type=oneshot
User=notes
Group=notes
WorkingDirectory=/opt/technical-notes/current
EnvironmentFile=/etc/technical-notes/site.env
Environment=BACKUP_DIR=/var/backups/technical-notes
ExecStart=/usr/bin/node scripts/html-scheduled-backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/technical-notes
