[Unit]
Description=Technical Notes HTML website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notes
Group=notes
WorkingDirectory=/opt/technical-notes/current
EnvironmentFile=/etc/technical-notes/site.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/technical-notes

[Install]
WantedBy=multi-user.target
